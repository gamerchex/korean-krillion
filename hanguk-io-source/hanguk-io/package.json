{
  "name": "hanguk-io",
  "version": "1.0.0",
  "private": true,
  "description": "HAN-GUK.IO: a daily Korean trivia dive where rarer valid answers sink you deeper.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "content": "node --import tsx scripts/content.ts",
    "content:check": "node --import tsx scripts/content.ts --check --verbose",
    "assets": "node --import tsx scripts/assets.ts",
    "build": "npm run content && npm run assets && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev --serve",
    "server": "node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts server/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "python3 scripts/e2e.py"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "*",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
